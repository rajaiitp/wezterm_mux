{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wezterm.org/schemas/automation-v1.json",
  "title": "WezTerm Automation API v1",
  "type": "object",
  "required": ["jsonrpc", "method"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "number", "null"] },
    "method": { "type": "string" },
    "params": { "type": ["object", "array", "string", "number", "boolean", "null"] }
  },
  "description": "Canonical envelope schema. Method-specific schemas are documented in PI_AGENT_INTEGRATION_PLAN.md."
}
